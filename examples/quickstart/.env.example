# Copy to `.env` and fill in the first block. `docker compose up` reads it from this directory.
#
#   cp .env.example .env && ${EDITOR:-vi} .env
#
# Nothing here is provider-specific: registration is RFC 3261, so any ITSP that issues SIP
# credentials is driven by the same handful of values.
#
# Everything below "Section 2" already has a working default. If you only want to hear the bot
# answer, fill in section 1 and stop reading.

# ════════════════════════════════════════════════════════════════════════════════════════════════
# 1. Fill these in. Nothing works until they are set.
# ════════════════════════════════════════════════════════════════════════════════════════════════

# ── The three vendors ───────────────────────────────────────────────────────────────────────────
# console.anthropic.com — an API key, not a Claude subscription.
ANTHROPIC_API_KEY=
# console.deepgram.com — streaming speech to text.
DEEPGRAM_API_KEY=
# play.cartesia.ai — streaming text to speech, plus a voice from the same dashboard.
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

# ── The provider's account, exactly as they issued it ───────────────────────────────────────────
# The values below are the RFC 3966 / RFC 5737 documentation shapes, so you can see the form each
# one takes. Every one of them has to be replaced.
SIP_AOR=sip:12345@sip.provider.example
SIP_REGISTRAR=sip:sip.provider.example
SIP_USERNAME=12345
SIP_PASSWORD=

# Their signalling host, used as the gateway group's destination.
SIP_PROVIDER_HOST=sip.provider.example

# The networks the provider sends calls from — they publish these. An INVITE from anywhere else is
# refused by route.py before it reaches the bot. The default below is the RFC 5737 documentation
# range and matches nothing real, so leaving it is a closed door rather than an open one.
SIP_PROVIDER_NETWORKS=203.0.113.0/24

# ── This host, as the provider can reach it ─────────────────────────────────────────────────────
# Goes into siphon's Contact and into the SDP the engine advertises. On a VPS this is its public
# IP; behind a home NAT it is the router's public address, and you need a port forward for the SIP
# port and the RTP range.
#
# This is the single most common thing to get wrong: a private address here registers perfectly
# and receives nothing at all.
PUBLIC_ADDRESS=203.0.113.10

# ── The control plane, so the bot can hang up and transfer ──────────────────────────────────────
# Shared secret between siphon.yaml's control app and the bot's control client. Any random string;
# it never leaves this host:
#
#   openssl rand -hex 16
AGENT_APP_TOKEN=

# ════════════════════════════════════════════════════════════════════════════════════════════════
# 2. Defaults that work. Change them when something on this host disagrees.
# ════════════════════════════════════════════════════════════════════════════════════════════════

SIP_TRANSPORT=udp

# Where the engine's media sockets actually bind: `0.0.0.0` on a directly-reachable host, the LAN
# address of the interface behind NAT.
MEDIA_BIND_IP=0.0.0.0

# The media range the firewall or port forward has to allow. Two ports per call leg.
RTP_PORT_MIN=30000
RTP_PORT_MAX=30999

# ── Ports ───────────────────────────────────────────────────────────────────────────────────────
# Everything runs on the host network, so these all share one port space with whatever else is on
# the machine. Change them here rather than fighting whatever already owns a port.
#
# SIP_PORT covers both transports. 5060 is rarely the right choice even when it is free: the
# well-known port is swept continuously, and every probe that lands is a transaction this node has
# to build and answer. A registered trunk reaches you through the Contact you register, which is
# built from this, so the provider never needs to know the number.
SIP_PORT=5060
RTP_CONTROL_PORT=8080
CONTROL_PORT=9092
BOT_PORT=9001

CONTROL_APP=agent-app

# Where the engine dials for each call's audio. `{call_id}` expands to the SIP Call-ID, which is
# also what arrives in the media `start` envelope — that is what joins the two channels. No compose
# default for this one: a `}` inside a `${VAR:-default}` ends the substitution early.
#
# The port here is not derived from BOT_PORT for the same reason. Change both together.
BOT_WS_URI=ws://127.0.0.1:9001/stream?call={call_id}

# ── What the bot is ─────────────────────────────────────────────────────────────────────────────
# Replaces the persona in agent_bot.py without editing it. Leave empty for the built-in one.
#
# Whatever you write here, keep the telephone constraints: speech not prose, no markdown, one or
# two sentences. A prompt written as if for a chat window produces bullet points, and the
# synthesizer reads them out loud, bullet by bullet.
#
# The hangup and transfer instructions are appended separately and are not overridable — they
# describe what this process can do, not who it is.
BOT_SYSTEM_PROMPT=

# Where the transfer_call tool sends the caller. Empty removes the tool and the model is never
# told it can transfer. The model chooses *whether*; this chooses *where*, because a destination
# the model could name is one the caller can talk it into naming.
BOT_TRANSFER_TARGET=

# ── Models ──────────────────────────────────────────────────────────────────────────────────────
# All optional: empty leaves the example's own pinned defaults, which are claude-haiku-4-5,
# Deepgram nova-3-general on `multi`, and Cartesia sonic-3.6.
#
# The model is worth choosing deliberately on a phone call. `claude-opus-5` runs adaptive thinking
# by default, which is right for hard reasoning and wrong for a receptionist: the caller hears
# silence while it thinks, on every turn. If you do want Opus on a call, the example pairs it with
# a low `output_config.effort` for you.
#BOT_LLM_MODEL=claude-haiku-4-5
#BOT_STT_MODEL=nova-3-general
#BOT_STT_LANGUAGE=multi
#BOT_TTS_MODEL=sonic-3.6

# Pipeline rate. Must equal `ws_sample_rate` on the profile in siphon.yaml, and must be 8000 or
# 16000 — the canceller and the noise suppressor exist only at those two rates.
#BOT_SAMPLE_RATE=16000

# ── Versions and logging ────────────────────────────────────────────────────────────────────────
SIPHON_SIP_VERSION=1.8.4
SIPHON_RTP_VERSION=0.5.0

# Raise the engine's media target to debug (`info,siphon_rtp::media=debug`) to see what the echo
# canceller's delay estimator concluded on each leg -- the delay it located and the window it
# searched. It warns when the peak is too flat to be an echo, which is what a route beyond the
# canceller's reach looks like from inside a canceller that is otherwise running perfectly.
ENGINE_LOG=info
SIP_LOG=info,siphon::rtpengine=debug,siphon::script=debug

# ── Turn-taking tuning ──────────────────────────────────────────────────────────────────────────
# Both of these exist because the bot's own voice can come back on the uplink and be transcribed as
# the caller, and both cost the caller some ability to interrupt. The engine is the right place to
# solve it -- siphon-rtp 0.5.0 vetoes the turn edge using the far-end reference no bot process has
# -- but that veto gates the engine's own speech_started, and this bot decides its turns from its
# recognizer, so it helps here only once the echo is gone from the audio. Run the engine with
# `siphon_rtp::media=debug` and read its delay report: a weak-lock warning means it is not.
#
# How long after the bot stops speaking to keep dropping transcriptions, in seconds. 0.6 by
# default. Set it to 0 on a leg with a confident lock, and on nothing else.
#BOT_ECHO_GUARD_TAIL=0.6
# How many words the caller must be heard saying before they may interrupt the bot. Applies only
# while the bot is speaking -- the echo arrives after that too, which is what the guard above is
# for. Two is the verified default.
#BOT_MIN_INTERRUPT_WORDS=2
